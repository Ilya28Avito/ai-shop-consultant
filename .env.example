# OpenAI API ключ
OPENAI_API_KEY=sk-...

# Redis URL (в Docker используй redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0

# Настройки модели
DEFAULT_MODEL=gpt-4o-mini
REQUEST_TIMEOUT=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Логирование
LOG_LEVEL=INFO

# ДЗ 5.6, шаг 5 — Phoenix-трейсинг (опционально). Если не задано — приложение
# просто не шлёт трейсы, всё остальное работает как обычно.
# Локальный запуск (uvicorn на хосте, Phoenix в Docker с проброшенным портом):
#   PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Запуск приложения ВНУТРИ docker compose (сервисы видят друг друга по имени):
#   PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ДЗ 5.6, шаг 3-4 — судья для RAGAS-метрик (scripts/run_eval.py). Дефолты в
# app/eval/metrics.py уже верные (gpt-4o-mini/openai/text-embedding-3-small),
# переопределять не обязательно — раскомментируй, только если понадобится
# поменять модель судьи.
# EVAL_JUDGE_MODEL=gpt-4o-mini
# EVAL_JUDGE_PROVIDER=openai
# EVAL_JUDGE_EMBEDDING_MODEL=text-embedding-3-small

# ДЗ 5.6, шаг 7/10 — A/B эксперимент 2 (generation) + финальная фиксация
# конфига. "full" — дефолт с шага 10 (не нужно даже прописывать эту строку):
# промпт для генерации строится из ПОЛНОГО текста найденного чанка, победил
# baseline ("snippet" — из 200-симв. сниппета) с явным отрывом на golden
# dataset (faithfulness 0.878 vs 0.664, answer_relevancy 0.748 vs 0.525,
# has_citation 0.909 vs 0.667 — см. docs/rag_evaluation.md). Раскомментируй
# и поставь "snippet", только если нужно временно вернуть прежнее поведение.
# RAG_CONTEXT_MODE=snippet

# ДЗ 5.6, шаг 10 — финальная конфигурация RAG (для справки, не переменные
# окружения — chunk_size/overlap зафиксированы в scripts/ingest.py, top_K и
# score threshold в app/services/rag.py):
#   chunking:            наивный посимвольный, chunk_size=512, overlap=64
#   embedding-модель:     text-embedding-3-small
#   generation-модель:    gpt-4o-mini, temperature=0
#   top_K:                5
#   re-ranker:            нет
#   score threshold:      0.30 (RAG_SCORE_THRESHOLD)
#   context для генерации: full (RAG_CONTEXT_MODE, см. выше)
# Числа этой конфигурации — tests/eval/results/2026-08-29_1709_full_context.csv
